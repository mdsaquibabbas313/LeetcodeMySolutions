/*

### 6. Left And Right Sum Differences

Given a $0$-indexed integer array `nums`, find a $0$-indexed integer array `answer` where:

* `answer.length == nums.length`.


* `answer[i] = |leftSum[i] - rightSum[i]|`.

Where:

* `leftSum[i]` is the sum of elements to the left of the index `i` in the array `nums`. If there is no such element, `leftSum[i] = 0`.


* `rightSum[i]` is the sum of elements to the right of the index `i` in the array `nums`. If there is no such element, `rightSum[i] = 0`.

Return the array `answer`.

**Example 1:**

* **Input:** `nums = [10, 4, 8, 3]`

* **Output:** `[15, 1, 11, 22]`
*/

// O(n^2) Bruth Force
import java.util.*;

public class Main {
    public static int[] sumOfiThIndex(int[] arr) {
        int n = arr.length;
        int[] ans = new int[n]; // Fixed array declaration syntax

        for (int i = 0; i < n; i++) {
            int leftSum = 0;
            int rightSum = 0;

            for (int j = i + 1; j < n; j++) {
                rightSum += arr[j];
            }

            for (int j = i - 1; j >= 0; j--) {
                leftSum += arr[j];
            }

            ans[i] = Math.abs(rightSum - leftSum);
        }

        return ans;
    }

    public static void main(String[] args) {
        // Test with Example 1 input
        int[] nums = {10, 4, 8, 3};
        
        // Call the method
        int[] answer = sumOfiThIndex(nums);
        
        // Print the result array
        System.out.println("Input: " + Arrays.toString(nums));
        System.out.println("Output: " + Arrays.toString(answer));
    }
}


O(N) & O(N) Time and Space

import java.util.*;

public class Main {
    public static int[] sumOfiThIndex(int[] arr) {
        int n = arr.length;
        int[] ans = new int[n]; // Fixed array declaration syntax
        int[] prefixSum = new int[n];
        int[] suffixSum = new int[n];
        int leftSum = 0;
        int rightSum = 0;
        for (int i = 0; i < n; i++) {
            leftSum += arr[i];
            prefixSum[i] = leftSum;

            int j = n - 1 - i;
            rightSum += arr[j];
            suffixSum[j] = rightSum;
        }

        for(int i = 0 ; i<n ; i++) {
          ans[i] = Math.abs(suffixSum[i] - prefixSum[i]);
        }

        return ans;
    }

    public static void main(String[] args) {
        // Test with Example 1 input
        int[] nums = {10, 4, 8, 3};
        
        // Call the method
        int[] answer = sumOfiThIndex(nums);
        
        // Print the result array
        System.out.println("Input: " + Arrays.toString(nums));
        System.out.println("Output: " + Arrays.toString(answer));
    }
}


O(N) TC & O(1) SC

import java.util.*;

public class Main {
    public static int[] sumOfiThIndex(int[] arr) {
        int n = arr.length;
        int[] ans = new int[n]; // Fixed array declaration syntax
        int totalSum = 0;

        int leftSum = 0;
        int rightSum = 0;

        for(int i : arr) totalSum += i;

        for(int i = 0 ; i<n ; i++) {
          
          rightSum = totalSum - leftSum - arr[i];

          ans[i] = Math.abs(rightSum - leftSum);

          leftSum = leftSum + arr[i];

        }

        return ans;
    }

    public static void main(String[] args) {
        // Test with Example 1 input
        int[] nums = {10, 4, 8, 3};
        
        // Call the method
        int[] answer = sumOfiThIndex(nums);
        
        // Print the result array
        System.out.println("Input: " + Arrays.toString(nums));
        System.out.println("Output: " + Arrays.toString(answer));
    }
}

